# Systemd Service Configuration
# Copy this file to /etc/systemd/system/telegram-bot.service
# Replace USERNAME and /path/to/bot with your actual values

[Unit]
Description=Telegram Video Downloader Bot
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/PATH/TO/TELEGRAM-DOWNLOADER-BOT
Environment="TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE"
ExecStart=/PATH/TO/TELEGRAM-DOWNLOADER-BOT/venv/bin/python bot.py
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/var/log/telegram-bot.log
StandardError=append:/var/log/telegram-bot-error.log

[Install]
WantedBy=multi-user.target
